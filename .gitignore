# Secrets and local environment
.env
.env.*
!.env.example

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Project-local Git worktrees
.worktrees/

# Packaging and build products
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# JAX compilation caches and profiles
.jax_cache/
*.nsys-rep
*.ncu-rep

# Local benchmark output
.benchmarks/
benchmarks/results/local/
benchmarks/r_example/results/*
!benchmarks/r_example/results/.gitkeep
benchmarks/baselines/**/*.jsonl

# Documentation builds
docs/_build/
site/

# R reference-run artifacts
.RData
.Rhistory
.Ruserdata
*.Rcheck/
renv/library/
renv/staging/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log
.cache/

# Keep the uv lockfile under version control for reproducibility.
!uv.lock
